POPUP_APP_MODE=server
POPUP_DATA_DIR=/data
# Local Docker test defaults. If you change POPUP_HOST_PORT, keep POPUP_BASE_URL in sync.
POPUP_HOST_PORT=8000
POPUP_BASE_URL=http://127.0.0.1:8000
# Set a long random value in production; if omitted, one is generated in POPUP_DATA_DIR.
# POPUP_SECRET_KEY=
POPUP_MAX_UPLOAD_MB=50
POPUP_IMPORT_MAX_MB=2048
POPUP_PROJECT_QUOTA_MB=1024

# One-time bootstrap credential for claiming the application-level Cocklebur Host.
# After the Host is claimed, this key is no longer accepted for Host login.
# The legacy COCKLEBUR_HOST_KEY name is still accepted for compatibility.
# Set one of these to a long random secret and give it only to the intended Host.
# COCKLEBUR_BOOTSTRAP_KEY=
# COCKLEBUR_HOST_KEY=
