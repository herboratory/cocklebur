POPUP_APP_MODE=server
POPUP_DATA_DIR=/data
# Local Docker test defaults. If you change POPUP_HOST_PORT, keep POPUP_BASE_URL in sync.
POPUP_HOST_PORT=8000
POPUP_BASE_URL=http://127.0.0.1:8000
# Set a long random value in production; if omitted, one is generated in POPUP_DATA_DIR.
# POPUP_SECRET_KEY=
POPUP_MAX_UPLOAD_MB=50
POPUP_IMPORT_MAX_MB=2048
POPUP_PROJECT_QUOTA_MB=1024
# Maximum uploaded Server Update package size.
COCKLEBUR_UPDATE_MAX_MB=512
# Server instance Host key. Required for New Project / Import Pack in Server mode.
# Set a long random secret for a stable deployment. If omitted, Cocklebur generates
# a persistent key at POPUP_DATA_DIR/.host_key. Do not share this with project members.
# COCKLEBUR_HOST_KEY=
