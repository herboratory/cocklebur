# =============================================================================
# Cocklebur 統一部署變數範本 (deploy/deploy.env.example)
# 
# 請複製此檔案為 deploy/deploy.env 並依您的環境設定填寫：
#   cp deploy/deploy.env.example deploy/deploy.env
# 
# 注意：deploy/deploy.env 已被 .gitignore 忽略，不會被誤提交至 Git。
# =============================================================================

# 全域預設設定
GLOBAL_NAMESPACE="cocklebur-app"
DEFAULT_TOOL="kustomize" # 可選: kustomize, helm, 或 docker
DEFAULT_IMAGE_TAG="latest"

# -----------------------------------------------------------------------------
# ENG 環境 (開發環境)
# -----------------------------------------------------------------------------
ENG_KUBE_CONTEXT="<your-eng-context>"
ENG_DOCKER_CONTEXT="<your-eng-docker-context>"
ENG_DOCKER_PORT=8000
ENG_REGISTRY="registry.example.com/team"
ENG_IMAGE_TAG="latest"
ENG_DEFAULT_DOMAIN="cocklebur-eng.example.com"
ENG_STORAGE_CLASS="local-path"
ENG_STORAGE_SIZE="10Gi"
ENG_INGRESS_CLASS="public"
ENG_INGRESS_TYPE="traefik" # traefik 或 nginx
ENG_TLS_SECRET="cocklebur-tls-eng"
ENG_CERT_ISSUER="internal-ca-issuer"
ENG_CERT_ISSUER_KIND="ClusterIssuer"
ENG_CA_SECRET="internal-ca-secret" # cert-manager 命名空間中的自簽 Root CA Secret

# -----------------------------------------------------------------------------
# UAT 環境 (驗收測試環境)
# -----------------------------------------------------------------------------
UAT_KUBE_CONTEXT="<your-uat-context>"
UAT_DOCKER_CONTEXT="<your-uat-docker-context>"
UAT_DOCKER_PORT=8001
UAT_REGISTRY="registry.example.com/team"
UAT_IMAGE_TAG="latest"
UAT_DEFAULT_DOMAIN="cocklebur-uat.example.com"
UAT_STORAGE_CLASS="local-path"
UAT_STORAGE_SIZE="10Gi"
UAT_INGRESS_CLASS="public"
UAT_INGRESS_TYPE="traefik"
UAT_TLS_SECRET="cocklebur-tls-uat"
UAT_CERT_ISSUER="internal-ca-issuer"
UAT_CERT_ISSUER_KIND="ClusterIssuer"
UAT_CA_SECRET="internal-ca-secret"

# -----------------------------------------------------------------------------
# STG 環境 (預發布環境)
# -----------------------------------------------------------------------------
STG_KUBE_CONTEXT="<your-stg-context>"
STG_DOCKER_CONTEXT="<your-stg-docker-context>"
STG_DOCKER_PORT=8000
STG_REGISTRY="registry.example.com/prod"
STG_IMAGE_TAG="latest"
STG_DEFAULT_DOMAIN="cocklebur-stg.example.com"
STG_STORAGE_CLASS="nfs-client"
STG_STORAGE_SIZE="10Gi"
STG_INGRESS_CLASS="public"
STG_INGRESS_TYPE="nginx"
STG_TLS_SECRET="cocklebur-tls-stg"
STG_CERT_ISSUER="letsencrypt-prod"
STG_CERT_ISSUER_KIND="ClusterIssuer"
STG_CA_SECRET=""

# -----------------------------------------------------------------------------
# PROD 環境 (正式生產環境)
# -----------------------------------------------------------------------------
PROD_KUBE_CONTEXT="<your-prod-context>"
PROD_DOCKER_CONTEXT="<your-prod-docker-context>"
PROD_DOCKER_PORT=8000
PROD_REGISTRY="registry.example.com/prod"
PROD_IMAGE_TAG="0.2.16"
PROD_DEFAULT_DOMAIN="cocklebur.example.com"
PROD_STORAGE_CLASS="standard"
PROD_STORAGE_SIZE="20Gi"
PROD_INGRESS_CLASS="public"
PROD_INGRESS_TYPE="nginx"
PROD_TLS_SECRET="cocklebur-tls-prod"
PROD_CERT_ISSUER="letsencrypt-prod"
PROD_CERT_ISSUER_KIND="ClusterIssuer"
PROD_CA_SECRET=""

# -----------------------------------------------------------------------------
# 應用程式容量配額設定 (所有環境共用或預設)
# -----------------------------------------------------------------------------
POPUP_MAX_UPLOAD_MB=50
POPUP_IMPORT_MAX_MB=2048
POPUP_PROJECT_QUOTA_MB=1024
